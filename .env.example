# ════════════════════════════════════════════════════
# .env.example — Legacy Moving Agent
# Copie para .env e preencha com seus valores reais
# NUNCA commite o .env real no repositório!
# ════════════════════════════════════════════════════

# ── ANTHROPIC (obrigatório) ──────────────────────────────────────────────
# Obter em: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── LEGACY MOVING ERP (obrigatório) ──────────────────────────────────────
# URL do backend do ERP Legacy Moving
LEGACY_API_URL=https://seu-backend.railway.app
# Token JWT de um usuario admin (fazer login no ERP e copiar o token)
LEGACY_JWT_TOKEN=eyJhbGci...

# ── EVOLUTION API - WhatsApp (obrigatório para produção) ─────────────────
# URL da instancia Evolution API no Railway
EVOLUTION_API_URL=https://sua-evolution.railway.app
# Chave de API da Evolution (você define ao criar)
EVOLUTION_API_KEY=sua-chave-aqui
# Nome da instancia WhatsApp criada na Evolution
EVOLUTION_INSTANCE=legacy-moving

# ── OPENAI - Transcricao de audio (opcional) ─────────────────────────────
# Obter em: https://platform.openai.com
# Necessario apenas para suporte a mensagens de voz
OPENAI_API_KEY=sk-...

# ── SEGURANÇA (recomendado) ───────────────────────────────────────────────
# Secret para validar autenticidade dos webhooks da Evolution
AGENT_SECRET=mude-para-uma-senha-forte-aqui

# ── FASE 2: GOOGLE CALENDAR (opcional — deixe vazio para desativar) ───────
# ID do calendário Google Calendar que o agente usará
# Use "primary" para o calendário principal da conta de serviço
GOOGLE_CALENDAR_ID=primary
# Credenciais da Service Account do Google (JSON completo em uma linha)
# Como obter: https://console.cloud.google.com → APIs → Google Calendar API → Credenciais
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
# Fuso horário dos eventos criados
CALENDAR_TIMEZONE=America/Sao_Paulo

# ── FASE 2: SCHEDULER DE NOTIFICAÇÕES ────────────────────────────────────
# Horário do resumo diário (formato 24h)
RESUMO_HORA=7
RESUMO_MINUTO=0
# Quantas horas antes da OS enviar o lembrete para a equipe
LEMBRETE_HORAS=24

# ── LOGS ─────────────────────────────────────────────────────────────────
# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Formato: text (local/dev) | json (Railway/produção)
LOG_FORMAT=json

# ── SERVIDOR ─────────────────────────────────────────────────────────────
PORT=5001
