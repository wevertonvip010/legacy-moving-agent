# ── ANTHROPIC (obrigatorio) ────────────────────────────────────────────────
# Obter em: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── LEGACY MOVING ERP (obrigatorio) ────────────────────────────────────────
# URL do backend do ERP Legacy Moving
LEGACY_API_URL=https://seu-backend.railway.app
# Token JWT de um usuario admin (fazer login no ERP e copiar o token)
LEGACY_JWT_TOKEN=eyJhbGci...

# ── EVOLUTION API - WhatsApp (obrigatorio para producao) ───────────────────
# URL da instancia Evolution API
EVOLUTION_API_URL=https://sua-evolution.railway.app
# Chave de API da Evolution
EVOLUTION_API_KEY=sua-chave-aqui
# Nome da instancia WhatsApp criada na Evolution
EVOLUTION_INSTANCE=legacy-moving

# ── OPENAI - Transcricao de audio (opcional) ───────────────────────────────
# Obter em: https://platform.openai.com
# Necessario apenas para suporte a mensagens de voz
OPENAI_API_KEY=sk-...

# ── SEGURANCA (recomendado) ────────────────────────────────────────────────
# Secret para validar autenticidade dos webhooks
WEBHOOK_SECRET=gere-uma-string-aleatoria-aqui

# Numeros autorizados a usar o agente (separados por virgula, sem espacos)
# Deixar vazio para liberar para todos os numeros
# Formato: 5511999998888,5521888887777
NUMEROS_AUTORIZADOS=

# ── SERVIDOR ────────────────────────────────────────────────────────────────
PORT=5001

# ── MEMORIA DE CONVERSAS ────────────────────────────────────────────────────
# Diretorio onde os historicos de conversa sao salvos
MEMORY_DIR=/tmp/agent_memory
