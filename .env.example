# ════════════════════════════════════════════════════════════
# .env.example — Legacy Moving Agent v4.0
# Projeto: legacymovingbr@gmail.com
# Copie para .env e preencha com seus valores reais.
# NUNCA commite o .env real no repositorio!
# ════════════════════════════════════════════════════════════

# ── EMPRESA ──────────────────────────────────────────────────────────────
# Dados da empresa — usados nos templates de notificacao e confirmacoes
COMPANY_NAME=Legacy Moving
COMPANY_EMAIL=legacymovingbr@gmail.com
COMPANY_WHATSAPP=5511999999999
COMPANY_WEBSITE=https://legacymoving.com.br
# Assinatura que aparece no rodape das mensagens ao cliente
COMPANY_TAGLINE=Legacy Moving — Cuidando do que e seu

# ── ANTHROPIC (obrigatorio) ───────────────────────────────────────────────
# Obter em: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── LEGACY MOVING ERP (obrigatorio) ──────────────────────────────────────
# URL do backend do ERP Legacy Moving
LEGACY_API_URL=https://seu-backend.railway.app
# Token JWT de um usuario admin (fazer login no ERP e copiar o token)
LEGACY_JWT_TOKEN=eyJhbGci...

# ── EVOLUTION API - WhatsApp (obrigatorio para producao) ─────────────────
# URL da instancia Evolution API no Railway
EVOLUTION_API_URL=https://sua-evolution.railway.app
# Chave de API da Evolution (voce define ao criar)
EVOLUTION_API_KEY=sua-chave-aqui
# Nome da instancia WhatsApp criada na Evolution
EVOLUTION_INSTANCE=legacy-moving

# ── OPENAI - Transcricao de audio (opcional) ─────────────────────────────
# Necessario apenas para suporte a mensagens de voz (Whisper)
OPENAI_API_KEY=sk-...

# ── SEGURANCA ────────────────────────────────────────────────────────────
# Token para proteger as rotas de admin (/admin/*)
AGENT_SECRET=mude-para-uma-senha-forte-aqui

# ── FASE 2: GOOGLE CALENDAR ──────────────────────────────────────────────
# A conta de servico Google deve ter o calendario de legacymovingbr@gmail.com
# compartilhado com ela (permissao de edicao).
#
# Passo a passo:
# 1. Crie Service Account em https://console.cloud.google.com
# 2. Ative Google Calendar API
# 3. Compartilhe o calendario de legacymovingbr@gmail.com com o email da SA
# 4. Copie o ID do calendario (em Configuracoes do Calendario > Integrar)
#
# ID do calendario (use o email como ID para o calendario principal da conta)
GOOGLE_CALENDAR_ID=legacymovingbr@gmail.com
# Credenciais da Service Account (JSON completo em uma linha)
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"legacy-moving-agent",...}
# Fuso horario
CALENDAR_TIMEZONE=America/Sao_Paulo

# ── FASE 2: SCHEDULER ────────────────────────────────────────────────────
# Horario do resumo diario (formato 24h)
RESUMO_HORA=7
RESUMO_MINUTO=0
# Horas antes da OS para enviar lembrete a equipe
LEMBRETE_HORAS=24

# ── FASE 3: GOOGLE DRIVE ─────────────────────────────────────────────────
# A mesma Service Account do Calendar e usada para o Drive.
# Compartilhe a pasta do Drive com o email da Service Account.
#
# Passo a passo:
# 1. Acesse o Google Drive com legacymovingbr@gmail.com
# 2. Crie uma pasta "Legacy Moving Agent"
# 3. Compartilhe essa pasta com o email da Service Account (editor)
# 4. Copie o ID da pasta (ultima parte da URL do Drive)
#
DRIVE_ROOT_FOLDER_ID=
# GOOGLE_CREDENTIALS_JSON ja foi configurado acima (mesmo JSON)

# ── FASE 4: CONTEXTO INDIVIDUAL ──────────────────────────────────────────
USER_CONTEXT_FILE=/tmp/user_contexts.json
# Role padrao para numeros nao cadastrados
DEFAULT_ROLE=bloqueado

# ── LOGS ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# text = legivel localmente | json = estruturado para Railway
LOG_FORMAT=json

# ── SERVIDOR ─────────────────────────────────────────────────────────────
PORT=5001
